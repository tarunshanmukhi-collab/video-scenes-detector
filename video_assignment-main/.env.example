
# --- general ---
VIDEO_PATH=data/video.mp4
VIDEO_URL=https://www.youtube.com/watch?v=NHQH5Y_zW_E
OUTPUT_DIR=outputs
TRANSCRIPT_PATH=outputs/transcript.txt

# --- shots (PySceneDetect AdaptiveDetector - the only shot method) ---
SHOTS_RUN=true
SHOTS_SPLIT_CLIPS=true

# --- faces (clustered separately within each scene) ---
FACES_RUN=true
FACES_BACKEND=auto
FACES_SAMPLE_FPS=2.0
FACES_FRAME_HEIGHT=720
FACES_NUM_PERSONS=
FACES_MIN_APPEARANCES=1

# --- scenes ---
SCENES_RUN=true
SCENES_SPLIT_CLIPS=true

# --- describe: fact-check descriptions against the real transcript ---
DESCRIBE_RUN=true

# --- clip_embeddings scene method (visual, local, no API) ---
CLIP_WINDOW_SECONDS=5.0
CLIP_MIN_SCENE_SECONDS=30.0
CLIP_PROMINENCE_FACTOR=1.0

# --- azure_llm scene method ---
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- gemini_multimodal scene method ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CUT_THRESHOLD=0.20
GEMINI_CUT_SCALE_WIDTH=320
GEMINI_SNAP_WINDOW_SEC=5.0
GEMINI_MIN_SCENE_SEC=1.0
GEMINI_UPLOAD_TIMEOUT_SEC=900

# Only needed if ffmpeg/ffprobe aren't on PATH (shared by every ffmpeg call):
FFMPEG_DIR=
